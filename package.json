{
  "name": "@dannybattison/tailor",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/check.ts",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron": "npm run build && electron electron/main.cjs",
    "build:lib": "node scripts/build-lib.mjs",
    "prepublishOnly": "npm test && npm run build:lib"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "lorem-ipsum": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.6"
  },
  "description": "Seeded design-system generator: palette, type, shape, motion and layout recipes. Library and MCP server.",
  "exports": {
    ".": {
      "types": "./src/lib-entry.ts",
      "default": "./src/lib-entry.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/lib-entry.ts",
  "bin": {
    "tailor-mcp": "./dist-lib/mcp.js"
  },
  "files": [
    "src",
    "dist-lib"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DannyBattison/tailor.git"
  },
  "homepage": "https://github.com/DannyBattison/tailor#readme",
  "bugs": {
    "url": "https://github.com/DannyBattison/tailor/issues"
  },
  "keywords": [
    "design-system",
    "theme",
    "generator",
    "mcp",
    "model-context-protocol",
    "design-tokens",
    "ai"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
